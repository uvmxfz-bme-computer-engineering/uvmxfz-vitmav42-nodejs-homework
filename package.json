  "repository": {
    "type": "git",
    "url": "git+https://github.com/uvmxfz-bme-computer-engineering/uvmxfz-vitmav42-nodejs-homework.git"
  },
  "license": "MIT",
  "author": "UVMXFZ",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "start": "npm run start:db && npm run start:app",
    "start:db": "pm2 start scripts/start-mongo.js --name mongodb || pm2 restart mongodb",
    "start:app": "pm2 start index.js --name app || pm2 restart app",
    "dev": "node --watch index.js",
    "restart": "pm2 restart mongodb app",
    "stop": "pm2 delete mongodb app",
    "stop:db": "pm2 delete mongodb",
    "stop:app": "pm2 delete app",
    "logs": "pm2 logs",
    "logs:db": "pm2 logs mongodb",
    "logs:app": "pm2 logs app"
  },
  "dependencies": {
    "body-parser": "^2.4.0",
    "bootstrap": "^5.3.8",
    "ejs": "^7.0.2",
    "express": "^5.2.1",
    "i18next": "^26.7.1",
    "i18next-fs-backend": "^2.6.10",
    "i18next-http-middleware": "^3.10.0",
    "jsdoc": "^4.0.5",
    "mocha": "^12.0.3",
    "mongoose": "^9.11.4"
  },
  "devDependencies": {
    "pm2": "^7.1.2"
  }
}

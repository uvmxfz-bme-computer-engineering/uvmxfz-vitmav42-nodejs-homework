<%- include('header') %>
<main class="container py-5">
	<div
		class="mb-4"
		id="new-category-form"
	>
		<h1
			class="h2 mb-2"
		>
			Create Category
		</h1>
		<form
			class="card card-body"
			id="category-form"
			method="post"
			action="/category/create"
		>
			<div
				class="row g-3 mb-3"
			>
				<div
					class="col-md-6"
				>
					<label
						class="form-label"
						for="category-name"
					>
						Category name*
					</label>
					<input
						class="form-control"
						id="category-name"
						name="name"
						required
					>
				</div>
				<div
					class="col-md-6"
				>
					<label
						class="form-label"
						for="category-slug"
					>
						Slug
					</label>
					<input
						class="form-control"
						id="category-slug"
						name="slug"
						placeholder="generated from the name when left empty"
					>
				</div>
			</div>
			<div
				class="row g-3 mb-3"
			>
				<div
					class="col-12"
				>
					<label
						class="form-label"
						for="category-description"
					>
						Description
					</label>
					<textarea
						class="form-control"
						id="category-description"
						name="description"
						rows="2"
					></textarea>
				</div>
			</div>
			<div
				class="row g-3"
			>
					<button
						class="btn btn-success w-100"
						type="submit"
					>
						Create
					</button>
			</div>
		</form>
	</div>
</main>
<%- include('footer') %>
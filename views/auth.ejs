<%- include('header') %>
<main class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h2 class="h5">Sign In</h2>
                    <form>
                        <div class="mb-3">
                            <label class="form-label" for="email">Email address</label>
                            <input class="form-control" id="email" name="email" type="email" placeholder="you@example.com" autocomplete="email" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="password">Password</label>
                            <input class="form-control" id="password" name="password" type="password" placeholder="Enter your password" required>
                        </div>
                        <button class="btn btn-dark w-100" type="submit">Sign In</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</main>
<%- include('footer') %>
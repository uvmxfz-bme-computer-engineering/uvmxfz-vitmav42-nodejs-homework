<%- include('header') %>
<div class="container-fluid">
	<div class="row">
		<%- include('sidebar') %>
		<main class="col-md-10 col-lg-11 p-4">
			<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
				<div>
					<h1 class="h2 mb-1">Featured products</h1>
					<p class="text-muted mb-0">Quality components for every build.</p>
				</div>
			</div>
			<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
				<h2 class="h5 mb-0" id="product-count">Found <%= products.length %> items</h2>
				<div class="d-flex flex-wrap justify-content-end align-items-end gap-3">
					<div>
						<label class="form-label small fw-semibold mb-1" for="sort-products">Sort by</label>
						<select class="form-select" id="sort-products">
							<option value="featured">Featured</option>
							<option value="price-asc">Price: Low to high</option>
							<option value="price-desc">Price: High to low</option>
							<option value="name-asc">Name: A to Z</option>
							<option value="name-desc">Name: Z to A</option>
						</select>
					</div>
				</div>
			</div>
			<div class="row g-4" id="product-grid">
				<% products.forEach((product) => { %>
					<div class="col-sm-6 col-xl-3 product-item" data-category="<%= product.category %>" data-name="<%= product.name %>" data-price="<%= product.price %>">
						<article class="card h-100 product-card"><img class="card-img-top p-3"
						                                              src="https://image.alza.cz/products/BD750m7b1/BD750m7b1.jpg?width=500&height=500"
						                                              alt="<%= product.name %>">
							<div class="card-body d-flex flex-column">
								<span class="badge text-bg-secondary align-self-start mb-2"><%= product.category %></span>
								<h2 class="h5"> <%= product.name %></h2>
								<p class="text-muted">8 cores, AM5 socket</p>
								<div class="d-flex flex-row justify-content-between align-items-end">
									<strong class="fs-5 mt-auto mb-3">$<%= product.price %></strong>
									<p class="text-muted">Stock: <%= product.stock %></p>
								</div>
								<button class="btn btn-dark">Add to cart</button>
							</div>
						</article>
					</div>
				<% }); %>
			</div>
		</main>
	</div>
</div>
<script>
	document.getElementById("category-filter").addEventListener("change", (event) => {
		const category = event.target.value;
		window.location.href = category
				? `?category=${encodeURIComponent(category)}`
				: window.location.pathname;
	});
</script>
<%- include('footer') %>
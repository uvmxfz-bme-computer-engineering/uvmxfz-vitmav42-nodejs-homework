<%- include('header') %>
<div class="container-fluid">
	<div class="row">
		<%- include('sidebar') %>
		<main class="col-md-10 col-lg-11 p-4">
			<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
				<div>
					<h1 class="h2 mb-1">Featured products</h1>
					<p class="text-muted mb-0">Quality components for every build.</p>
				</div>
			</div>
			<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
				<h2 class="h5 mb-0" id="product-count">Found <%= products.length %> items</h2>
				<div class="d-flex flex-wrap justify-content-end align-items-end gap-3">
					<div>
						<label class="form-label small fw-semibold mb-1" for="sort-products">Sort by</label>
						<select class="form-select" id="sort-products">
							<option value="featured">Featured</option>
							<option value="price-asc">Price: Low to high</option>
							<option value="price-desc">Price: High to low</option>
							<option value="name-asc">Name: A to Z</option>
							<option value="name-desc">Name: Z to A</option>
						</select>
					</div>
				</div>
			</div>
			<div class="row g-4" id="product-grid">
				<% products.forEach((product) => { %>
					<div class="col-sm-6 col-xl-3 product-item">
						<article class="card product-card">
							<img class="card-img-top"
								src="<%= product.imageUrl || 'https://via.placeholder.com/500x500?text=-' %>"
								alt="<%= product.name %>">
							<div class="card-body d-flex flex-column">
								<h2 class="h5"> <%= product.name %></h2>
								<div class="d-flex flex-row justify-content-between align-items-end">
									<p class="text-muted"><%= product.description || '-' %></p>
									<span class="badge text-bg-secondary align-self-start mb-2">
										<%= product._category ? product._category.name : '-' %>
									</span>
								</div>
								<div class="d-flex flex-row justify-content-between align-items-end">
									<strong class="fs-5 mt-auto mb-3">$<%= product.price %></strong>
									<p class="text-muted"><% if (product.stock > 0) { %>
										Stock: <%= product.stock %>
									<% } else { %>
										Out of stock
									<% } %></p>
								</div>
								<% const cartQuantity = cartQuantities[String(product._id)] || 0; %>
								<form method="post" action="/cart/create/<%= product._id %>">
									<input type="hidden" name="quantity" value="1">
									<button class="btn btn-dark w-100"
											type="submit"
											<%= product.stock > 0 && cartQuantity < 1 ? '' : 'disabled' %>>
										<%= cartQuantity > 0 ? 'In cart' : 'Add to cart' %>
									</button>
								</form>
								</div>
						</article>
					</div>
				<% }); %>
			</div>
		</main>
	</div>
</div>
<script>
	// Sort products functionality
	const sortSelect = document.getElementById('sort-products');
	sortSelect.addEventListener('change', () => {
		const sortValue = sortSelect.value;
		const productGrid = document.getElementById('product-grid');
		const products = Array.from(productGrid.getElementsByClassName('product-item'));

		products.sort((a, b) => {
			const aPrice = parseFloat(a.querySelector('.fs-5').textContent.replace('$', ''));
			const bPrice = parseFloat(b.querySelector('.fs-5').textContent.replace('$', ''));
			const aName = a.querySelector('h2').textContent.toLowerCase();
			const bName = b.querySelector('h2').textContent.toLowerCase();

			switch (sortValue) {
				case 'price-asc':
					return aPrice - bPrice;
				case 'price-desc':
					return bPrice - aPrice;
				case 'name-asc':
					return aName.localeCompare(bName);
				case 'name-desc':
					return bName.localeCompare(aName);
				default:
					return 0;
			}
		});

		productGrid.innerHTML = '';
		products.forEach(product => productGrid.appendChild(product));
	});
	//
</script>
<%- include('footer') %>
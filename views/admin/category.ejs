<section id="category-management">
	<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
		<div><h1 class="h2">Category management</h1>
			<p class="text-muted mb-0">Edit the list of categories or add a new category.</p>
		</div>
		<a 	class="btn btn-dark" 
			id="add-category-button"
			type="button"
		   	href="category/create">
		Add new category
		</a>
	</div>
	<div class="card">
		<div class="table-responsive">
			<table class="table align-middle mb-0" id="category-table">
				<thead>
				<tr>
					<th scope="col">Name</th>
					<th scope="col">Slug</th>
					<th scope="col">Description</th>
					<th scope="col">Created At</th>
					<th scope="col">Updated At</th>
					<th class="text-end">Actions</th>
				</tr>
				</thead>
				<tbody>
				<% if (categories.length === 0) { %>
				<tr>
					<td colspan="<%= 6 %>" class="text-center text-muted">no categories found :(</td>
				</tr>
				<% } else { categories.forEach((category) => { %>
				<tr>
					<td><%= category.name || '-' %></td>
					<td><%= category.slug || '-' %></td>
					<td><%= category.description || '-' %></td>
					<td><%= category.createdAt.toLocaleString() || 'N/A' %></td>
					<td><%= category.updatedAt.toLocaleString() || 'N/A' %></td>
					<td class="text-end">
						<a class="btn btn-sm btn-outline-primary edit-btn" href="/category/edit/<%= category._id %>">Edit</a>
						<a class="btn btn-sm btn-outline-danger delete-btn" href="/category/delete/<%= category._id %>">Delete</a>
					</td>
				</tr>
				<% }); } %>
				</tbody>
			</table>
		</div>
	</div>
	<div id="category-message" class="alert alert-success mt-3 d-none"></div>
</section>

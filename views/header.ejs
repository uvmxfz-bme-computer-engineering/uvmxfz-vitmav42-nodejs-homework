<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>PC Components Shop</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .product-card img {
            height: 180px;
            object-fit: contain;
        }
        .sidebar-link {
            color: #fff;
            text-decoration: none;
        }
        .sidebar-link:hover, .sidebar-link.active {
            text-decoration: underline;
        }
        .order-items td {
            background: #f8f9fa;
        }
        .order-item + .order-item {
            border-top: 1px solid #dee2e6;
        }
    </style>
</head>
<body class="bg-light">
<header class="navbar navbar-dark bg-dark px-3">
    <a class="navbar-brand fw-bold" href="/">PC Components Shop</a>
    <nav class="d-flex gap-3">
        <a class="text-white text-decoration-none" href="cart">Cart</a>
        <a class="text-white text-decoration-none" href="orders">Orders</a>
        <a class="text-white text-decoration-none" href="admin">Admin</a>
    </nav>
</header>
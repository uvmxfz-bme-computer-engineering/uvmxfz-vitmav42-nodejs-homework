<aside class="col-md-2 col-lg-1 bg-dark text-white min-vh-100 p-3">
    <h1 class="h5 mb-3">Categories</h1>
    <p class="small mb-3">Filter products by category.</p>
    <nav class="nav flex-column gap-2">
        <a class="sidebar-link" href="/">> All</a>
        <% (categories.sort((a, b) => a.name.localeCompare(b.name)) || []).forEach((category) => { %>
            <a class="sidebar-link" href="?category=<%= category.slug %>">> <%= category.name %></a>
        <% }) %>
    </nav>
</aside>